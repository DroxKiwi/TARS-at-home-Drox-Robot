# TARS Voice — copie vers .env (ne pas committer)
TARS_PORT=9743
TARS_HOST=0.0.0.0

# Postgres (réglages UI + system prompt) — service docker tars-postgres
# Host: localhost:5433 | Conteneurs: tars-postgres:5432
DATABASE_URL=postgresql://tars:tars@tars-postgres:5432/tars

# CORS pour l'UI Next (LAN). * = autoriser toutes origines (dev local)
CORS_ORIGINS=*
WEB_UI_URL=https://localhost:3000
# IP LAN pour le certificat HTTPS de tars-web (ex. 192.168.1.42)
# HTTPS_SANS=192.168.1.42

# Ollama local (PC Windows Docker Desktop → host.docker.internal)
# Linux prod VM : http://172.17.0.1:11434 ou IP de l'hôte
# Note: URL/modèle UI sont persistés en DB ; ces valeurs seedent le 1er démarrage.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M
# Spécialistes = rôles en DB (UI). Nb de msgs d'historique transmis au rôle :
# ROLE_HISTORY_MESSAGES=8

# STT (faster-whisper) — device/compute restent infra ; modèle seed DB
WHISPER_MODEL=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
WHISPER_LANGUAGE=fr

# TTS Kokoro — chemins / seed voix (édition UI → DB)
KOKORO_VOICE=ff_siwis
KOKORO_SPEED=1.0

# Tool calling Ollama
TOOLS_ENABLED=true
TOOLS_MAX_ROUNDS=4

# SearXNG local (service docker tars-searxng) — UI http://localhost:8088
SEARXNG_URL=http://tars-searxng:8080

# Session audio (infra ; silence/VAD aussi éditables via DB après seed)
SAMPLE_RATE=16000
SILENCE_MS=700
MAX_UTTERANCE_MS=15000

# Barge-in
BARGE_IN_ENABLED=true
BARGE_IN_MIN_SPEECH_MS=180

# TTS backend seed + CosyVoice service
TTS_BACKEND=kokoro
COSYVOICE_URL=http://tars-tts-cosy:9750
COSYVOICE_VOICES_DIR=/data/voices

# Export métriques / runs (volume → ./data/metrics sur l'hôte)
METRICS_DIR=/data/metrics
METRICS_EXPORT_ENABLED=true

# Flotte : allowlist SSH (regex séparées par virgules). Vide = défaut sûr
# (uname, hostname, uptime, df -h, …). Voir docs/fleet-uplink.md
# FLEET_SSH_ALLOWLIST=^uname( -a)?$,^hostname$,^uptime$
