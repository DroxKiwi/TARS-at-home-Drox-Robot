# Dev Dockerfile — hot reload via volume mount + HTTPS local
FROM node:22-alpine
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci || npm install
COPY . .
EXPOSE 3000
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV NODE_ENV=development
ENV VOICE_INTERNAL_URL=http://tars-voice:9743
CMD ["npm", "run", "dev"]
